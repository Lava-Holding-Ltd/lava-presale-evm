ICOSale.buyToken

when sale is not finalized and params are valid and round checks pass
    it transfers _ref.amount of ERC20 from buyer to TREASURY_WALLET
        expect token balance of TREASURY_WALLET to increase by _ref.amount
    it increases refundable[buyer][_ref.asset] by _ref.amount
        expect refundable[buyer][_ref.asset] to increase by _ref.amount
    it updates totalUsdRaised, walletUsdRaised, and allocations
        expect mapping's values to increase by correct amounts
    it emits Purchased with correct arguments
        expect Purchased(currentRoundId, buyer, refCode, refType, _ref.asset, normalizedAmount, usdValue, base, refBonus, toBuyer)

when sale is finalized
    it reverts
        expect revert with SaleAlreadyFinalized

when _ref.amount is zero
    it reverts
        expect revert with ZeroAmount

when _ref.asset is zero address or not approved
    it reverts
        expect revert with NotAcceptedAsset

when _ref.refType is not NoReferral and refCode is empty
    it reverts
        expect revert with InvalidReferralType

when _ref.refType is not one of Influencer or Media and not NoReferral
    it reverts
        expect revert with InvalidReferralType

when _ref.buyer != msg.sender (signature payload)
    it reverts
        expect revert with NotBuyer

when _ref.roundId != currentRoundId (signature payload)
    it reverts
        expect revert with InactiveRound

when _ref.nonce != nonces(_ref.buyer) (signature payload)
    it reverts
        expect revert with NonceMismatch

when _ref.deadline < block.timestamp (signature payload)
    it reverts
        expect revert with ExpiredSignature

when recovered signer != owner (signature payload)
    it reverts
        expect revert with InvalidSignature

when current round is inactive
    it reverts
        expect revert with InactiveRound

when block.timestamp is outside [startTime, endTime]
    it reverts
        expect revert with InvalidTimeframe

when computed usdValue < minUsdPerTx
    it reverts
        expect revert with UnderMin

when totalUsdRaised + usdValue > HARD_CAP_USD
    it reverts
        expect revert with HardCapExceeded

when walletUsdRaised[buyer] + usdValue > MAX_USD_PER_WALLET
    it reverts
        expect revert with WalletCapExceeded

when toBuyer > (round.capTotal - round.soldTokens)
    it reverts
        expect revert with CapReached

when toBuyer > (MAX_TOTAL_ALLOCATION_TOKENS - totalAllocatedTokens)
    it reverts
        expect revert with CapReached
